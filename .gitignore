# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
data/settings.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local clipper runtime
/data
/.venv
__pycache__/
*.pyc

# rust / tauri
/target
/license-server/target
/src-tauri/target
/src-tauri/gen
/src-tauri/resources/server/**
!/src-tauri/resources/server/.keep
/src-tauri/resources/bin/**
!/src-tauri/resources/bin/.keep
/src-tauri/resources/python/
/src-tauri/resources/fonts/**
!/src-tauri/resources/fonts/.keep
/src-tauri/resources/scripts/
/src-tauri/resources/.cache/
/dist
*.sec
license-server/data/
